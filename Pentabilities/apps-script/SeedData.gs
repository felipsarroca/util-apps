function seedInitialDataIfNeeded(spreadsheet) {
  const studentsSheet = spreadsheet.getSheetByName(SHEETS.students);
  if (studentsSheet.getLastRow() <= 1) {
    seedRows(spreadsheet, SHEETS.students, SEED_STUDENTS);
    seedRows(spreadsheet, SHEETS.teachers, SEED_TEACHERS);
    seedRows(spreadsheet, SHEETS.skills, SEED_SKILLS);
    seedRows(spreadsheet, SHEETS.behaviors, SEED_BEHAVIORS);
    seedRows(spreadsheet, SHEETS.cycles, SEED_CYCLES);
    seedRows(spreadsheet, SHEETS.sessions, SEED_SESSIONS);
    seedRows(spreadsheet, SHEETS.sessionBehaviors, SEED_SESSION_BEHAVIORS);
    seedRows(spreadsheet, SHEETS.sessionHeteroStudents, SEED_SESSION_HETERO_STUDENTS);
  }
  const properties = PropertiesService.getScriptProperties();
  if (properties.getProperty(APP.seedVersionProperty) === APP.seedVersion) return;
  repairSeedData(spreadsheet);
  properties.setProperty(APP.seedVersionProperty, APP.seedVersion);
}

function seedRows(spreadsheet, sheetName, rows) {
  if (!rows.length) return;
  const sheet = spreadsheet.getSheetByName(sheetName);
  const headers = HEADERS[sheetName];
  const values = rows.map((row) => headers.map((header) => row[header] ?? ''));
  sheet.getRange(sheet.getLastRow() + 1, 1, values.length, headers.length).setValues(values);
}

function repairSeedData(spreadsheet) {
  syncSeedRowsById(spreadsheet, SHEETS.students, 'alumne_id', SEED_STUDENTS, ['nom', 'cognoms', 'nom_complet', 'classe', 'actiu']);
  syncSeedRowsById(spreadsheet, SHEETS.teachers, 'professor_id', SEED_TEACHERS, ['nom', 'cognoms', 'nom_complet', 'email', 'rol', 'actiu']);
  syncSeedRowsById(spreadsheet, SHEETS.skills, 'habilitat_id', SEED_SKILLS, ['codi_habilitat', 'nom_habilitat', 'descripcio', 'color', 'ordre']);
  syncSeedRowsById(spreadsheet, SHEETS.behaviors, 'comportament_id', SEED_BEHAVIORS, ['codi_comportament', 'habilitat_id', 'nom_comportament', 'descripcio', 'ordre', 'actiu']);
  syncSeedRowsById(spreadsheet, SHEETS.cycles, 'cicle_id', SEED_CYCLES, ['nom_cicle', 'classe', 'professor_id', 'data_inici', 'data_final', 'estat', 'descripcio']);
  syncSeedRowsById(spreadsheet, SHEETS.sessions, 'sessio_id', SEED_SESSIONS, ['cicle_id', 'nom_sessio', 'classe', 'data_sessio', 'codi_acces', 'estat', 'professor_id']);
}

function syncSeedRowsById(spreadsheet, sheetName, idField, rows, fields) {
  const sheet = spreadsheet.getSheetByName(sheetName);
  if (!sheet || sheet.getLastRow() <= 1) return;
  const values = sheet.getDataRange().getValues();
  const headers = values[0];
  const idIndex = headers.indexOf(idField);
  if (idIndex < 0) return;
  const rowIndexById = {};
  for (let i = 1; i < values.length; i += 1) rowIndexById[String(values[i][idIndex])] = i + 1;
  rows.forEach((row) => {
    const targetRow = rowIndexById[String(row[idField])];
    if (!targetRow) return;
    fields.forEach((field) => {
      const col = headers.indexOf(field);
      if (col >= 0) sheet.getRange(targetRow, col + 1).setValue(row[field] ?? '');
    });
  });
}
