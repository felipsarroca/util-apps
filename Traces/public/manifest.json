{
  "manifest_version": 3,
  "name": "Traces — Procés d'elaboració a Google Docs",
  "short_name": "Traces",
  "version": "1.1.0",
  "description": "Analitza de manera visual, local i en català com s'ha elaborat un treball a Google Docs: temps actiu, sessions, autors i insercions en bloc.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Obre Traces per analitzar el document"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/d/*",
        "https://docs.google.com/document/u/*/d/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel.html",
        "favicon.svg",
        "assets/*",
        "icons/*"
      ],
      "matches": [
        "https://docs.google.com/*",
        "https://classroom.google.com/*"
      ]
    }
  ],
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://docs.google.com/document/*",
    "https://classroom.google.com/*",
    "https://felipsarroca.github.io/*"
  ]
}
