# Identificador de client OAuth de Google (Google Cloud del centre, tipus «Aplicació web»).
# Sense aquest valor, l'aplicació funciona en mode de demostració amb dades fictícies.
VITE_GOOGLE_CLIENT_ID=
# Adreça del servidor (mode connectat). Sense aquest valor, «Et veig» funciona en demostració.
VITE_API_URL=
# Només amb el servidor local de proves (npm run server:local): entrada amb comptes fictícis.
VITE_DEV_AUTH=

# ---------- Servidor (server/, fase 5) ----------
# No hi posis mai valors reals en aquest fitxer: es configuren al proveïdor d'allotjament.
# Cadena de connexió de Neon (regió de la UE, amb sslmode=require).
DATABASE_URL=
# El mateix identificador de client OAuth que el frontend: el servidor comprova l'audiència del testimoni.
GOOGLE_CLIENT_ID=
# Clau de xifratge dels esborranys: 32 bytes en base64 (p. ex. openssl rand -base64 32).
DRAFT_KEY=
# Curs actiu, p. ex. 2026-2027.
ACADEMIC_YEAR=
# Opcionals.
SCHOOL_DOMAIN=ramonpont.cat
ALLOWED_ORIGIN=https://felipsarroca.github.io
PORT=8080
# Proves del servidor contra un PostgreSQL real (p. ex. una branca de Neon amb db/schema.sql i db/dades-prova.sql).
TEST_DATABASE_URL=
