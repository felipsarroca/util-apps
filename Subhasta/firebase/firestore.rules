rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Tothom (alumnat, projecció i organitzadors) entra amb un usuari anònim de Firebase.
    // Qualsevol persona pot crear una subhasta; només qui l'ha creada la pot dirigir.

    function autenticat() {
      return request.auth != null;
    }

    function sessioDoc(sessioId) {
      return get(/databases/$(database)/documents/sessions/$(sessioId)).data;
    }

    function esPropietari(sessioId) {
      return autenticat()
        && exists(/databases/$(database)/documents/sessions/$(sessioId))
        && sessioDoc(sessioId).propietariUid == request.auth.uid;
    }

    function sessioNoCaducadaData(data) {
      return data.expiraMs is int && data.expiraMs > request.time.toMillis();
    }

    function sessioVigent(sessioId) {
      return autenticat()
        && exists(/databases/$(database)/documents/sessions/$(sessioId))
        && sessioNoCaducadaData(sessioDoc(sessioId));
    }

    function carteraDoc(sessioId, uid) {
      return get(/databases/$(database)/documents/sessions/$(sessioId)/carteres/$(uid)).data;
    }

    // Després del lot o la transacció: la cartera de qui escriu ve d'un traspàs d'aparell des de «uidAntic»
    function traspasCapA(sessioId, uidAntic) {
      return getAfter(/databases/$(database)/documents/sessions/$(sessioId)/carteres/$(request.auth.uid)).data.transferitDesDe == uidAntic;
    }

    function esTraspas(sessioId) {
      return getAfter(/databases/$(database)/documents/sessions/$(sessioId)/carteres/$(request.auth.uid)).data.transferitDesDe is string;
    }

    function formatCodi(codi) {
      return codi.matches('^([A-Z0-9]{4}|[0-9]{6})$');
    }

    // Llista antiga d'organitzadors: ja no es fa servir
    match /config/{doc} {
      allow read, write: if false;
    }

    // Codi de sala (4 caràcters alfanumèrics; 6 xifres a les sales antigues) -> sessioId
    match /codis/{codi} {
      allow get: if autenticat() && formatCodi(codi);
      allow list: if false;
      allow create: if formatCodi(codi)
        && request.resource.data.sessioId is string
        && request.resource.data.expiraMs is int
        && esPropietari(request.resource.data.sessioId);
      allow update: if formatCodi(codi)
        && request.resource.data.sessioId is string
        && request.resource.data.expiraMs is int
        && esPropietari(request.resource.data.sessioId)
        && (resource.data.expiraMs < request.time.toMillis() || esPropietari(resource.data.sessioId));
      allow delete: if formatCodi(codi)
        && (resource.data.expiraMs < request.time.toMillis() || esPropietari(resource.data.sessioId));
    }

    // Configuracions desades amb nom (v1.3): privades del propietari i amb caducitat (com a molt uns 13 mesos)
    match /configuracions/{configId} {
      function campsConfig() {
        return request.resource.data.id == configId
          && request.resource.data.propietariUid == request.auth.uid
          && request.resource.data.nom is string
          && request.resource.data.nom.size() >= 1
          && request.resource.data.nom.size() <= 60
          && request.resource.data.cfg is map
          && request.resource.data.cfg.objectes is list
          && request.resource.data.cfg.objectes.size() >= 1
          && request.resource.data.cfg.objectes.size() <= 12
          && request.resource.data.expiraMs is int
          && request.resource.data.expiraMs <= request.time.toMillis() + 34560000000;
      }
      allow read: if autenticat() && resource.data.propietariUid == request.auth.uid;
      allow create: if autenticat() && campsConfig();
      allow update: if autenticat() && resource.data.propietariUid == request.auth.uid && campsConfig();
      allow delete: if autenticat() && resource.data.propietariUid == request.auth.uid;
    }

    match /sessions/{sessioId} {
      function camps() {
        return request.resource.data.titol is string
          && request.resource.data.titol.size() >= 1
          && request.resource.data.titol.size() <= 60
          && request.resource.data.repte is string
          && request.resource.data.repte.size() <= 280
          && request.resource.data.moneda is string
          && request.resource.data.moneda.size() >= 1
          && request.resource.data.moneda.size() <= 16
          && request.resource.data.pressupost is int
          && request.resource.data.pressupost >= 1
          && request.resource.data.pressupost <= 100000
          && request.resource.data.increment is int
          && request.resource.data.increment >= 1
          && request.resource.data.increment <= request.resource.data.pressupost
          && request.resource.data.estat in ['preparacio', 'espera', 'en_curs', 'finalitzada']
          && request.resource.data.expiraMs is int;
      }

      function esOrg() {
        return autenticat() && sessioDoc(sessioId).propietariUid == request.auth.uid;
      }

      // Una sessió caducada només la pot llegir qui la va crear (per eliminar-la)
      allow get: if autenticat()
        && (sessioNoCaducadaData(resource.data) || resource.data.propietariUid == request.auth.uid);
      // «Les meves subhastes»: cadascú només llista les seves
      allow list: if autenticat() && resource.data.propietariUid == request.auth.uid;

      allow create: if autenticat()
        && request.resource.data.propietariUid == request.auth.uid
        && camps();

      allow update: if autenticat() && camps() && (
        // L'organitzador (no pot cedir-la a ningú altre directament)
        (resource.data.propietariUid == request.auth.uid
          && request.resource.data.propietariUid == resource.data.propietariUid)
        // Traspàs a un compte de Google vinculat en un altre ordinador
        || (request.auth.token.email != null
          && request.auth.token.email_verified == true
          && resource.data.reclamableCorreu == request.auth.token.email
          && request.resource.data.propietariUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['propietariUid', 'reclamableCorreu']))
      );

      allow delete: if autenticat() && resource.data.propietariUid == request.auth.uid;

      // Objectes del catàleg
      match /objectes/{objId} {
        allow read: if sessioVigent(sessioId);
        allow create, update: if esOrg()
          && request.resource.data.nom is string
          && request.resource.data.nom.size() >= 1
          && request.resource.data.nom.size() <= 40
          && request.resource.data.quantitat is int
          && request.resource.data.quantitat >= 1
          && request.resource.data.quantitat <= 60
          && request.resource.data.preuSortida is int
          && request.resource.data.preuSortida >= 1;
        allow delete: if esOrg();
      }

      // Balanç de tothom: només existeix quan l'organitzador decideix projectar-lo
      match /estat/balanc {
        allow read: if sessioVigent(sessioId);
        allow write: if esOrg();
      }

      // Tauler en temps real (únic document que canvia a cada oferta)
      match /estat/tauler {
        allow read: if sessioVigent(sessioId);
        allow create, delete: if esOrg();

        allow update: if sessioVigent(sessioId) && (
          esOrg()
          ||
          // Oferta d'un participant, a nom seu, amb totes les garanties
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['licitacio', 'actualitzatMs', 'ultimEsdeveniment'])
            && resource.data.licitacio != null
            && resource.data.licitacio.estat == 'oberta'
            && request.resource.data.licitacio != null
            && request.resource.data.licitacio.estat == 'oberta'
            && request.resource.data.licitacio.objecteId == resource.data.licitacio.objecteId
            && request.resource.data.licitacio.unitat == resource.data.licitacio.unitat
            && request.resource.data.licitacio.preuSortida == resource.data.licitacio.preuSortida
            && request.resource.data.licitacio.increment == resource.data.licitacio.increment
            && request.resource.data.licitacio.liderUid == request.auth.uid
            && request.resource.data.licitacio.liderUid != resource.data.licitacio.liderUid
            && request.resource.data.licitacio.numOfertes == resource.data.licitacio.numOfertes + 1
            && request.resource.data.licitacio.importActual is int
            && (
              (resource.data.licitacio.numOfertes == 0 && request.resource.data.licitacio.importActual >= resource.data.licitacio.preuSortida)
              || (resource.data.licitacio.numOfertes > 0 && request.resource.data.licitacio.importActual >= resource.data.licitacio.importActual + resource.data.licitacio.increment)
            )
            && ((request.resource.data.licitacio.importActual - resource.data.licitacio.preuSortida) % resource.data.licitacio.increment) == 0
            && request.resource.data.licitacio.ultimesOfertes is list
            && request.resource.data.licitacio.ultimesOfertes.size() <= 3
            && exists(/databases/$(database)/documents/sessions/$(sessioId)/carteres/$(request.auth.uid))
            && carteraDoc(sessioId, request.auth.uid).habilitada == true
            && carteraDoc(sessioId, request.auth.uid).alies == request.resource.data.licitacio.liderAlies
            && request.resource.data.licitacio.importActual <= sessioDoc(sessioId).pressupost - carteraDoc(sessioId, request.auth.uid).gastat
          )
        );
      }

      // Participants públics (àlies)
      match /participants/{uid} {
        allow read: if sessioVigent(sessioId);
        allow create: if sessioVigent(sessioId)
          && request.resource.data.uid == uid
          && request.resource.data.alies is string
          && request.resource.data.alies.size() >= 1
          && request.resource.data.alies.size() <= 24
          && (
            esOrg()
            || (request.auth.uid == uid && (sessioDoc(sessioId).inscripcionsObertes == true || esTraspas(sessioId)))
          );
        allow update: if sessioVigent(sessioId) && (
          esOrg()
          // L'aparell nou desactiva l'antic en un canvi d'aparell
          || (request.auth.uid != uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actiu'])
            && request.resource.data.actiu == false
            && traspasCapA(sessioId, uid))
        );
        allow delete: if sessioVigent(sessioId) && esOrg();
      }

      // Carteres privades: només el titular llegeix la seva; l'organitzador, totes
      match /carteres/{uid} {
        allow get: if sessioVigent(sessioId) && (request.auth.uid == uid || esOrg());
        allow list: if sessioVigent(sessioId) && esOrg();
        allow create: if sessioVigent(sessioId)
          && request.resource.data.uid == uid
          && request.resource.data.alies is string
          && request.resource.data.alies.size() >= 1
          && request.resource.data.alies.size() <= 24
          && (
            esOrg()
            // Cartera nova a zero, amb inscripcions obertes
            || (request.auth.uid == uid
              && sessioDoc(sessioId).inscripcionsObertes == true
              && request.resource.data.gastat == 0
              && request.resource.data.compres is list
              && request.resource.data.compres.size() == 0
              && request.resource.data.habilitada == true)
            // Canvi d'aparell amb un codi vàlid: la cartera és idèntica a l'antiga
            || (request.auth.uid == uid
              && request.resource.data.transferitDesDe is string
              && request.resource.data.codiCanvi is string
              && request.resource.data.habilitada == true
              && get(/databases/$(database)/documents/sessions/$(sessioId)/canvis/$(request.resource.data.codiCanvi)).data.targetUid == request.resource.data.transferitDesDe
              && get(/databases/$(database)/documents/sessions/$(sessioId)/canvis/$(request.resource.data.codiCanvi)).data.usat == false
              && get(/databases/$(database)/documents/sessions/$(sessioId)/canvis/$(request.resource.data.codiCanvi)).data.expiraMs > request.time.toMillis()
              && request.resource.data.alies == carteraDoc(sessioId, request.resource.data.transferitDesDe).alies
              && request.resource.data.gastat == carteraDoc(sessioId, request.resource.data.transferitDesDe).gastat
              && request.resource.data.compres == carteraDoc(sessioId, request.resource.data.transferitDesDe).compres)
          );
        allow update: if sessioVigent(sessioId) && (
          esOrg()
          // L'aparell nou inhabilita la cartera antiga en un canvi d'aparell
          || (request.auth.uid != uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['habilitada', 'substituitPer', 'actualitzatMs'])
            && request.resource.data.habilitada == false
            && request.resource.data.substituitPer == request.auth.uid
            && traspasCapA(sessioId, uid))
        );
        allow delete: if sessioVigent(sessioId) && esOrg();
      }

      // Reserva d'àlies (unicitat sense distingir majúscules): ningú en fa list
      match /alies/{aliesNorm} {
        allow get: if sessioVigent(sessioId);
        allow list: if false;
        allow create: if sessioVigent(sessioId)
          && request.resource.data.uid is string
          && (
            esOrg()
            || (request.resource.data.uid == request.auth.uid
              && (sessioDoc(sessioId).inscripcionsObertes == true || esTraspas(sessioId)))
          );
        allow update: if sessioVigent(sessioId) && (
          esOrg()
          || (request.resource.data.uid == request.auth.uid
            && (resource.data.uid == request.auth.uid || traspasCapA(sessioId, resource.data.uid)))
        );
        allow delete: if sessioVigent(sessioId) && (esOrg() || resource.data.uid == request.auth.uid);
      }

      // Codis temporals de 4 xifres per a canvi d'aparell (els crea l'organitzador)
      match /canvis/{codi4} {
        allow get: if sessioVigent(sessioId) && codi4.matches('^[0-9]{4}$');
        allow list: if false;
        allow create, delete: if sessioVigent(sessioId) && codi4.matches('^[0-9]{4}$') && esOrg();
        allow update: if sessioVigent(sessioId) && codi4.matches('^[0-9]{4}$') && (
          esOrg()
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usat'])
            && request.resource.data.usat == true
            && resource.data.usat == false
            && getAfter(/databases/$(database)/documents/sessions/$(sessioId)/carteres/$(request.auth.uid)).data.codiCanvi == codi4)
        );
      }

      // Adjudicacions
      match /adjudicacions/{adjId} {
        allow read: if sessioVigent(sessioId);
        allow write: if sessioVigent(sessioId) && esOrg();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
